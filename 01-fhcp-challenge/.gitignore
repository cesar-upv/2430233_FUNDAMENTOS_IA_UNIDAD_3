# Local environment and generated caches
.env
.env.*
!.env.example
.venv/
/.tools/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.DS_Store

# LaTeX intermediate files (source and deliverable PDF remain trackable)
docs/latex/build/
docs/latex/**/*.aux
docs/latex/**/*.bbl
docs/latex/**/*.bcf
docs/latex/**/*.blg
docs/latex/**/*.fdb_latexmk
docs/latex/**/*.fls
docs/latex/**/*.lof
docs/latex/**/*.log
docs/latex/**/*.lot
docs/latex/**/*.out
docs/latex/**/*.run.xml
docs/latex/**/*.synctex.gz
docs/latex/**/*.toc

# Local FHCP recovery copies; the original dataset stays tracked.
/data/raw/fhcp-*/

# Local exploratory runs; preserve artifacts without adding logs to Git.
/experiments/results/search-exploration-*/
/experiments/results/distributed-*/
